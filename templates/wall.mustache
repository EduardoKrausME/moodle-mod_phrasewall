{{!
    @template mod_feedbackwall/wall

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="feedbackwall" data-region="feedbackwall">
    <div class="feedbackwall__toolbar">
        <div class="feedbackwall__count">{{countlabel}}</div>
        {{#anonymous}}
            <div class="feedbackwall__privacy">{{anonymousnotice}}</div>
        {{/anonymous}}
        {{#canviewreport}}
            <a class="btn btn-outline-secondary btn-sm" href="{{reporturl}}">{{reportlabel}}</a>
        {{/canviewreport}}
    </div>

    {{#hasposts}}
        <div class="feedbackwall__grid">
            {{#posts}}
                <article class="feedbackwall__card">
                    <div class="feedbackwall__quote" aria-hidden="true">“</div>
                    <div class="feedbackwall__message">{{message}}</div>
                    <div class="feedbackwall__footer">
                        <div class="feedbackwall__avatar" aria-hidden="true">{{initial}}</div>
                        <div class="feedbackwall__meta">
                            <div class="feedbackwall__author">{{author}}</div>
                            <div class="feedbackwall__time">{{time}}</div>
                        </div>
                    </div>
                </article>
            {{/posts}}
        </div>
    {{/hasposts}}

    {{^hasposts}}
        <div class="feedbackwall__empty">
            <div class="feedbackwall__empty-icon" aria-hidden="true">“”</div>
            <strong>{{noresponses}}</strong>
            <span>{{noresponsesdescription}}</span>
        </div>
    {{/hasposts}}
</div>
